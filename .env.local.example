# Copy to .env.local for local development.
# For production, set the same variables in Vercel → Project → Settings → Environment Variables.
# See docs/DEPLOYMENT.md for staging-first deploy steps and DNS guidance.

# ─── App URL ─────────────────────────────────────────────────────────────────
# Local: http://localhost:3000
# Production (Activora): https://activora.uk
# Inlined at build time — after changing in Vercel, redeploy for links/redirects to update.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production value: NEXT_PUBLIC_APP_URL=https://activora.uk

# ─── Supabase (database, auth, storage) ──────────────────────────────────────
# Use the project URL only, e.g. https://your-project.supabase.co (not /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required for Admin Users API in production (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth (Dashboard → Authentication → URL Configuration):
#   Site URL: https://activora.uk
#   Redirect URLs:
#     https://activora.uk/**
#     https://www.activora.uk/**
# Admin magic-link callback: https://activora.uk/admin/auth/callback

# ─── Data & storage ──────────────────────────────────────────────────────────
NEXT_PUBLIC_DATA_PROVIDER=supabase
# Production: use supabase (localStorage is dev-only fallback)
NEXT_PUBLIC_IMAGE_STORAGE_PROVIDER=supabase

# Optional: pin a default provider UUID instead of slug lookup
# NEXT_PUBLIC_DEFAULT_PROVIDER_ID=

# ─── Mapbox (parent session search map, geocoding) ───────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── AI search assistant (Phase 1 — activity discovery only) ────────────────
# Optional. When unset, /api/ai/search uses a local keyword parser instead.
# OPENAI_API_KEY=
# OPENAI_SEARCH_MODEL=gpt-4o-mini
# AI_SEARCH_ONLY=true

# ─── Address lookup (UK — club session wizard) ───────────────────────────────
# Prefer GETADDRESS_API_KEY in production (server-only, used by /api/addresses)
GETADDRESS_API_KEY=
# Alternative client-exposed key (avoid in production if possible)
NEXT_PUBLIC_GETADDRESS_API_KEY=

# ─── Stripe Connect — test (sk_test_/pk_test_) or live (sk_live_/pk_live_) ───
# Mode is detected from key prefix; secret and publishable keys must match.
# Developers → API keys. Never commit real keys.
# Publishable key cannot be derived from secret — paste both from the dashboard.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional server-only fallback (also exposed safely via /api/stripe/connect/config)
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...) for the same test/live mode as your API keys
# Staging endpoint: https://activora.uk/api/stripe/webhook
# Production endpoint: https://activora.uk/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ─── Temporary test admin login (server-side only — remove before production) ─
# Used by /admin-login and POST /api/admin/test-login. Never expose in NEXT_PUBLIC_*.
# Generate credentials: npm run admin:regenerate-credentials (prints password once)
ADMIN_TEST_EMAIL=admin-test@activora.local
ADMIN_TEST_PASSWORD=

# ─── Emergency admin access recovery (server-only — production recovery) ─────
# ADMIN_EMERGENCY_PIN: required for emergency PIN recovery when UI is enabled
# ADMIN_EMERGENCY_PIN_UI_ENABLED: set true to show emergency PIN on /admin/login
# ADMIN_EMERGENCY_EMAIL: defaults to adminactivora@gmail.com
# ADMIN_REPAIR_TOKEN: required query param for /admin/repair-access?token=...
# ADMIN_LOCKOUT_ENABLED: set true to re-enable 5-attempt / 15-min client lockout
ADMIN_EMERGENCY_PIN=
ADMIN_EMERGENCY_PIN_UI_ENABLED=false
ADMIN_EMERGENCY_EMAIL=adminactivora@gmail.com
ADMIN_REPAIR_TOKEN=
ADMIN_LOCKOUT_ENABLED=false

# ─── Admin invite email (optional — copy-link fallback when unset) ───────────
# RESEND_API_KEY=
# EMAIL_FROM=Activora <noreply@activora.co.uk>
# ADMIN_INVITE_EMAIL_PROVIDER=resend

# ─── GoCardless — provider subscription billing (Pro/Franchise) ──────────────
# sandbox for staging; live for production
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
# Legacy alias for GOCARDLESS_ENVIRONMENT
GOCARDLESS_ENV=sandbox
# Webhook endpoint: https://activora.uk/api/gocardless/webhook
GOCARDLESS_WEBHOOK_SECRET=
