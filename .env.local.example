# Copy to .env.local for local development.
# For production, set the same variables in Vercel → Project → Settings → Environment Variables.
# See docs/DEPLOYMENT.md for staging-first deploy steps and DNS guidance.

# ─── App URL ─────────────────────────────────────────────────────────────────
# Local: http://localhost:3000
# Staging: https://app.mydomain.co.uk
# Production: https://mydomain.co.uk
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (database, auth, storage) ──────────────────────────────────────
# Use the project URL only, e.g. https://your-project.supabase.co (not /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Data & storage ──────────────────────────────────────────────────────────
NEXT_PUBLIC_DATA_PROVIDER=supabase
# Production: use supabase (localStorage is dev-only fallback)
NEXT_PUBLIC_IMAGE_STORAGE_PROVIDER=supabase

# Optional: pin a default provider UUID instead of slug lookup
# NEXT_PUBLIC_DEFAULT_PROVIDER_ID=

# ─── Mapbox (parent session search map, geocoding) ───────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─── Address lookup (UK — club session wizard) ───────────────────────────────
# Prefer GETADDRESS_API_KEY in production (server-only, used by /api/addresses)
GETADDRESS_API_KEY=
# Alternative client-exposed key (avoid in production if possible)
NEXT_PUBLIC_GETADDRESS_API_KEY=

# ─── Stripe Connect — test (sk_test_/pk_test_) or live (sk_live_/pk_live_) ───
# Mode is detected from key prefix; secret and publishable keys must match.
# Developers → API keys. Never commit real keys.
# Publishable key cannot be derived from secret — paste both from the dashboard.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional server-only fallback (also exposed safely via /api/stripe/connect/config)
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...) for the same test/live mode as your API keys
# Staging endpoint: https://app.mydomain.co.uk/api/stripe/webhook
# Production endpoint: https://mydomain.co.uk/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ─── Temporary test admin login (server-side only — remove before production) ─
# Used by /admin-login and POST /api/admin/test-login. Never expose in NEXT_PUBLIC_*.
# Generate credentials: npm run admin:regenerate-credentials (prints password once)
ADMIN_TEST_EMAIL=admin-test@activora.local
ADMIN_TEST_PASSWORD=

# ─── GoCardless — provider subscription billing (Pro/Franchise) ──────────────
# sandbox for staging; live for production
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_ENVIRONMENT=sandbox
# Legacy alias for GOCARDLESS_ENVIRONMENT
GOCARDLESS_ENV=sandbox
# Staging endpoint: https://app.mydomain.co.uk/api/gocardless/webhook
# Production endpoint: https://mydomain.co.uk/api/gocardless/webhook
GOCARDLESS_WEBHOOK_SECRET=
