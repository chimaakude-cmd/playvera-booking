{
  "name": "playvera-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev -p 3000",
    "build": "next build",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "generate:release-draft": "node scripts/generate-release-draft.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:stripe-fees": "npx tsx scripts/test-stripe-fees.ts",
    "test:stripe-connect": "npx tsx scripts/test-stripe-connect-status.ts",
    "test:stripe-connect-errors": "npx tsx scripts/test-stripe-connect-errors.ts",
    "check:stripe-env": "npx tsx --env-file=.env.local scripts/check-stripe-env.ts",
    "sync:stripe-publishable": "npx tsx scripts/sync-stripe-publishable.ts",
    "admin:regenerate-credentials": "node scripts/generate-admin-test-credentials.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@types/qrcode": "^1.5.6",
    "gocardless-nodejs": "^8.4.0",
    "lucide-react": "^1.18.0",
    "mapbox-gl": "^3.24.1",
    "next": "16.2.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "stripe": "^22.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "sharp": "^0.35.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
